{
  "name": "dilara-bparty",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "wrangler types --check && tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test --project=smoke --project=network --project=dev --project=admin",
    "test:e2e:webkit": "playwright test --project=webkit-smoke --project=webkit-network --project=webkit-admin",
    "media": "playwright test --project=media",
    "rehearse": "node e2e/rehearsal/main.ts",
    "seed": "node scripts/preview-seed.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "preact": "^11.1.1",
    "uqr": "^0.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
