#!/bin/sh
# The check a pull request must pass: a clean install, the typecheck, the worker tests and the browser tests in Chromium, then WebKit.
set -e
cd "$(dirname "$0")/.."
export WRANGLER_SEND_METRICS=false
npm ci --no-audit --no-fund
npm run typecheck
npm test
# A failed browser test's page snapshot goes into the output, since the runner keeps nothing else.
# The review log shows only the tail, so each test's name and error come after its snapshot, and its source is left out.
section() { awk -v want="$1" '/^# /{at=$0} at==want' "$2"; }
# Memory while a suite runs, since the browsers are gone by the time it fails: available memory and the biggest processes every 5 s.
sample() {
  while :; do
    printf '%s avail=%sM %s\n' "$(date +%T)" "$(awk '/MemAvailable/ { print int($2 / 1024) }' /proc/meminfo)" \
      "$(ps -eo rss=,comm= --sort=-rss | head -5 | awk '{ printf "%s:%dM ", $2, $1 / 1024 }')"
    sleep 5
  done
}
e2e() {
  memory=$(mktemp)
  sample > "$memory" &
  sampler=$!
  if npm run "$1"; then
    kill "$sampler"
    rm -f "$memory"
    return
  fi
  kill "$sampler"
  find test-results -name error-context.md | while read -r context; do
    echo "=== $context"
    section "# Page snapshot" "$context"
    section "# Test info" "$context"
    section "# Error details" "$context"
  done
  echo "=== memory during $1: the five lowest samples, then the last three"
  sort -t= -k2 -n "$memory" | head -5
  tail -3 "$memory"
  exit 1
}
e2e test:e2e
e2e test:e2e:webkit
