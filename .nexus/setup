#!/bin/sh
# Runs once per template, as user. Playwright's own Chromium download is blocked here, so the smoke test uses Debian's.
set -e
cd "$(dirname "$0")/.."
.nexus/resume --setup
sudo DEBIAN_FRONTEND=noninteractive apt-get update -q
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q chromium fonts-dejavu-core fonts-roboto-unhinted ffmpeg
npx playwright install ffmpeg
