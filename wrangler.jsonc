{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dilara-bparty",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "routes": [{ "pattern": "party.handmadeoasis.com", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": ["/*", "!/assets/*", "!/robots.txt", "!/favicon.svg"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PARTY", "class_name": "Party" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Party"] }],
  "secrets": { "required": ["JOIN_SECRET", "ADMIN_SECRET"] },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "dilara-bparty-staging",
      "workers_dev": true,
      "routes": [],
      "durable_objects": {
        "bindings": [{ "name": "PARTY", "class_name": "Party" }]
      },
      "secrets": { "required": ["JOIN_SECRET", "ADMIN_SECRET"] }
    }
  }
}
